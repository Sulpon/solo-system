NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JARVIS - which LLM provider backs app/api/jarvis/route.ts. Defaults to
# "anthropic" when unset (existing Phase 14-19.5 behavior, unchanged). Set
# to "ollama" for Local JARVIS - a real local model via Ollama, no API key,
# no cloud request, no cost. Whichever provider is selected, GET
# /api/jarvis reports its real status (never a secret) if you want to check
# without opening JARVIS.
JARVIS_PROVIDER=anthropic

# --- Anthropic (cloud) --------------------------------------------------
# Required only when JARVIS_PROVIDER=anthropic (or unset). Server-side
# only, never exposed to the browser (no NEXT_PUBLIC_ prefix, never sent to
# the client, never written to localStorage/Atlas snapshot). Without it,
# JARVIS shows a graceful "no provider configured" state and the rest of
# Atlas is completely unaffected.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional - defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (local) ------------------------------------------------------
# Used only when JARVIS_PROVIDER=ollama. No key needed - local inference
# requires no credential at all. All four have sensible defaults (shown
# here) and only need to be set if your local Ollama setup differs.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M
# Phase 19.7 - confirmed empirically on modest hardware (RTX 3050 4GB/8GB
# RAM): the model's own max context (40960) left only ~24% of it resident
# in VRAM; num_ctx:8192 raised that to ~58% (verified live via Ollama's own
# /api/ps). num_predict is a hard generation-length ceiling, not a
# "think less" switch - too low truncates the model mid-thought before it
# ever reaches an answer (confirmed: 256 did exactly this). Raise
# OLLAMA_NUM_CTX only if you have more VRAM; lower OLLAMA_NUM_PREDICT only
# if you've confirmed your own prompts don't need more room.
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=2048

# Desktop (Tauri) release builds only - `npm run dev:desktop` reads
# .env.local exactly like the ordinary browser dev server (Next.js loads it
# itself), so nothing extra is needed there. A RELEASE build is different:
# Next.js's bundled standalone server (what src-tauri/src/lib.rs spawns)
# does not read .env.local at runtime - it only sees whatever is already in
# its OWN process environment. Before launching a release build of
# Atlas.exe, set ANTHROPIC_API_KEY (and ANTHROPIC_MODEL, if used) as a real
# Windows user/system environment variable - never bundle it into the
# installer, never place it inside src-tauri/.
