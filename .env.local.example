NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JARVIS (Phase 14) - optional. Server-side only, never exposed to the
# browser (no NEXT_PUBLIC_ prefix). Without it, JARVIS shows a graceful
# "unavailable" state and the rest of Atlas is completely unaffected.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional - defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
